/* Palette follows the reference screenshot: near-black ground, lavender accent. */
$atlas-bg: #0c0c15;
$atlas-panel: #090b12;
$atlas-text: #e4e4ec;
$atlas-muted: #9a9aa8;
$atlas-accent: #b49cf0;
$atlas-accent-ink: #14101f;
$atlas-rule: #6f5fa8;
$atlas-select: #3b2f5c;
$atlas-hover: #1d1d2e;

Screen {
    background: $atlas-bg;
    color: $atlas-text;
}

/* One header row plus a lavender rule; narrow terminals add a search row. */
#top-bar {
    height: 2;
    background: $atlas-bg;
    border-bottom: solid $atlas-rule;
}

#header {
    width: 1fr;
    height: 1;
    padding: 0 1;
    background: $atlas-bg;
    border: none;
}

#search-box {
    width: 34;
    height: 1;
    margin: 0 1 0 0;
}

#search-icon {
    width: 2;
    height: 1;
    color: $atlas-accent;
    text-style: underline;
}

/* The search field is an underline, not a box. */
#search-input, #search-trigger {
    width: 1fr;
    height: 1;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: $atlas-accent;
    text-style: underline;
    content-align: left middle;
    text-align: left;
}

#search-input:focus, #search-trigger:focus {
    border: none;
    background: $atlas-hover;
    text-style: bold underline;
}

#search-input > .input--cursor {
    background: $atlas-accent;
    color: $atlas-accent-ink;
}

#search-input > .input--placeholder {
    color: $atlas-muted;
}

Button {
    min-width: 3;
    height: 2;
    padding: 0;
    border: none;
    background: transparent;
    color: $atlas-text;
    text-style: none;
    content-align: center middle;
}

Button:hover, Button:focus {
    background: $atlas-hover;
    color: #ffffff;
    text-style: none;
}

#main {
    height: 1fr;
}

#left-panel {
    width: 1fr;
    min-width: 24;
    height: 1fr;
    background: $atlas-panel;
}

#globe {
    height: 1fr;
    min-height: 8;
}

#side-panel {
    width: 1fr;
    min-width: 32;
    height: 1fr;
    background: $atlas-bg;
}

/* Tabs: World │ Favorites │ Recent, active one underlined in lavender. */
#navigation {
    height: 2;
    padding: 0 1;
    border-bottom: solid $atlas-rule;
}

#navigation Button {
    width: auto;
    height: 1;
    padding: 0 1;
}

#navigation Button.active {
    color: $atlas-accent;
    background: transparent;
    text-style: bold underline;
}

#navigation Button:focus {
    background: $atlas-hover;
}

.tab-sep {
    width: 1;
    height: 1;
    color: $atlas-rule;
}

#list-heading {
    height: 1;
    padding: 0 1;
    color: $atlas-muted;
    text-overflow: ellipsis;
    text-wrap: nowrap;
}

#map-context {
    display: none;
}

#tables {
    height: 1fr;
}

DataTable {
    height: 1fr;
    background: $atlas-bg;
    color: $atlas-text;
    scrollbar-color: #41414d;
    scrollbar-background: $atlas-bg;
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 0;
}

DataTable > .datatable--header {
    background: #191921;
    color: $atlas-muted;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: $atlas-select;
    color: #ffffff;
    text-style: none;
}

DataTable > .datatable--hover {
    background: $atlas-hover;
}

DataTable > .datatable--even-row, DataTable > .datatable--odd-row {
    background: $atlas-bg;
}

#player-info {
    height: 4;
    layers: base top;
}

/* Top rule, then three lines on a shared 2-column axis: heading, station, metadata. */
#now-playing {
    layer: base;
    width: 1fr;
    height: 4;
    padding: 0 2;
    background: $atlas-bg;
    border-top: solid $atlas-rule;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* The favorite star floats over the station line; Python pins it right after the name. */
#player-favorite {
    layer: top;
    width: 3;
    height: 1;
    margin: 0;
    content-align: center middle;
    text-align: center;
}

#player-favorite.active {
    background: transparent;
    color: #f5c542;
    text-style: bold;
}

#player-favorite:disabled {
    opacity: 50%;
}

/* One blank row, then a single control row; the volume group wraps below only when too narrow. */
#transport {
    height: 2;
    padding: 1 2 0 2;
}

#transport.wrapped {
    layout: vertical;
    height: 3;
}

#transport-buttons {
    width: auto;
    height: 1;
}

#transport Button {
    width: 3;
    height: 1;
    margin: 0 2 0 0;
    padding: 0;
    content-align: center middle;
    text-align: center;
}

#transport Button:hover, #transport Button:focus {
    background: #2a2a40;
    color: #ffffff;
}

#transport Button:focus {
    text-style: bold;
}

/* Filled lavender pill, as in the reference. */
#transport #control-play {
    width: 5;
    background: $atlas-accent;
    color: $atlas-accent-ink;
    text-style: bold;
}

#transport #control-play:hover, #transport #control-play:focus {
    background: #cdbdf7;
    color: $atlas-accent-ink;
}

#transport #control-stop {
    margin-right: 0;
}

#volume-group {
    width: 1fr;
    height: 1;
    margin-left: 2;
    align-horizontal: right;
}

#transport.wrapped #volume-group {
    margin-left: 0;
    align-horizontal: left;
}

#volume-group #control-mute {
    margin: 0 1 0 0;
}

#transport #control-mute.active {
    color: $atlas-accent;
    text-style: bold;
}

/* 4 (VOL ) + 24 segments + 5 (percent) */
#volume-bar {
    width: 1fr;
    max-width: 33;
    height: 1;
    content-align: left middle;
}

#key-footer {
    height: 2;
    background: $atlas-bg;
}

/* Search gets its own complete row before the header becomes crowded. */
.narrow #top-bar {
    height: 3;
}

.narrow #search-box {
    dock: bottom;
    width: 1fr;
    margin: 0;
    padding: 0 1;
}

.narrow #side-panel {
    width: 2fr;
}

/* Keep the station workspace usable below the split-pane minimum. */
.compact #main {
    layout: vertical;
}

.compact #map-context {
    display: block;
    height: 1;
    padding: 0 1;
    color: $atlas-muted;
    background: $atlas-panel;
}

.compact #left-panel {
    display: none;
}

.compact #side-panel {
    width: 1fr;
    min-width: 0;
    border-left: none;
}
